# ==============================================================================
# AeroFeria — Variables de Entorno (Plantilla de Configuración)
# ==============================================================================
# Copia este archivo a '.env' y completa con los valores correspondientes.
# NUNCA subas el archivo '.env' real al repositorio.

# ------------------------------------------------------------------------------
# 1. Configuración General de la Aplicación y Red
# ------------------------------------------------------------------------------
APP_NAME=AeroFeria
APP_ENV=development
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. Base de Datos (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=aeroferia_db
POSTGRES_USER=aeroferia_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_HOST=aeroferia-db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Backend Spring Boot 3.4 (Java 21)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://aeroferia-db:5432/aeroferia_db
SPRING_DATASOURCE_USERNAME=aeroferia_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Clave Secreta para Tokens JWT (Mínimo 256 bits / 32+ caracteres)
JWT_SECRET=replace_this_with_a_super_long_and_secure_secret_key_minimum_256_bits_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# Credenciales de Arranque para el Administrador Inicial
INITIAL_ADMIN_EMAIL=admin@aeroferia.com
INITIAL_ADMIN_PASSWORD=AdminAeroFeria2026!
INITIAL_ADMIN_NAME=Administrador General
INITIAL_ADMIN_PHONE=5491100000000

# Parámetros de Almacenamiento y Optimización de Imágenes
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 4. Frontend Angular & Integraciones
# ------------------------------------------------------------------------------
API_BASE_URL=/api/v1
WHATSAPP_API_BASE=https://wa.me
